{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::aws-terraform-enterprise-lab-tfstate-opeth"
    },
    {
      "Sid": "TerraformDevState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::aws-terraform-enterprise-lab-tfstate-opeth/environments/dev/terraform.tfstate",
        "arn:aws:s3:::aws-terraform-enterprise-lab-tfstate-opeth/environments/dev/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "ReadSharedState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::aws-terraform-enterprise-lab-tfstate-opeth/infrastructure/shared/terraform.tfstate"
    }
  ]
}
